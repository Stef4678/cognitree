{
	"name": "cognitree",
	"version": "1.0.0",
	"description": "AI-powered branching knowledge trees for Obsidian — type one concept and grow it into a deep, interconnected network of notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": [
		"obsidian",

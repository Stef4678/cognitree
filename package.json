	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.14.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.21.5",
		"obsidian": "^1.5.7",
		"tslib": "^2.6.3",
		"typescript": "^5.5.4"
	},
	"dependencies": {
		"jsonrepair": "^3.15.0"
	}
}
